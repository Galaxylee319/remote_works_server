[Unit]
Description=Remote Works Server - sync_dirs 外部目录实时镜像
Documentation=file:/home/galaxybot/remote_works_server/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/galaxybot/remote_works_server
ExecStart=/home/galaxybot/remote_works_server/venv/bin/python3 /home/galaxybot/remote_works_server/sync_external_dirs.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rws-sync

[Install]
WantedBy=default.target
